{% extends 'base.html.twig' %}

{% block title %}Log in!
{% endblock %}

{% block body %}
	<form method="post">
		{% if error %}
			<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
		{% endif %}

		{% if app.user %}
			<div class="mb-3">
				Actualmente tiene la sesión iniciada con el email 
				{{ app.user.userIdentifier }}, haga click en el botón para cerrar su sesión actual.
				<a class="btn btn-sm btn-danger" href="{{ logout_path() }}">Cerrar sesión</a>
			</div>
		{% endif %}

		<h1>Por favor inicia sesión</h1>
		<div class="mb-3">
			<label for="inputEmail">Email</label>
			<input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
		</div>

		<div class="mb-3">
			<label for="inputPassword">Contraseña</label>
			<input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
			<input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
		</div>

		<div class="checkbox mb-3">
			<label class="form-check-label">
				<input class="form-check-input" type="checkbox" name="_remember_me">
				Recordarme
			</label>
		</div>

		<button class="btn btn-success" type="submit">
			Iniciar sesión
		</button>
		<a class="btn btn-primary" href="{{ path('app_register') }}">Registrarse</a>
	</form>
{% endblock %}
