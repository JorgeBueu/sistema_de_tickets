{% extends 'baseTicket.html.twig' %}

{% block title %}Show Ticket
{% endblock %}

{% block body %}
	<table class="table table-striped table-bordered">
		<tr>
			<th>Título</th>
			<td>{{ticket.title}}</td>
		</tr>
		<tr>
			<th>Descripción</th>
			<td>{{ticket.description}}</td>
		</tr>
		<tr>
			<th>Fecha creación</th>
			<td>{{ticket.createdAt|date()}}</td>
		</tr>
		<tr>
			<th>Creador</th>
			<td>{{ticket.creator.email}}</td>
		</tr>
	</table>

	<a class="btn btn-primary" href="{{ path('app_ticket_list') }}">Volver</a>
{% endblock %}
