{% extends 'baseTicket.html.twig' %}

{% block title %}Show Ticket
{% endblock %}

{% block body %}

	<h1>Información del ticket</h1>

	<table class="table table-striped table-bordered">
		<tr>
			<th>Título</th>
			<td>{{ticket.title}}</td>
		</tr>
		<tr>
			<th>Descripción</th>
			<td>{{ticket.description}}</td>
		</tr>
		<tr>
			<th>Fecha creación</th>
			<td>{{ticket.createdAt|date('d/m/Y H:i', 'Europe/Madrid')}}</td>
		</tr>
		<tr>
			<th>Creador</th>
			<td>{{ticket.creator.email}}</td>
		</tr>
	</table>

	<a class="btn btn-primary" href="{{ path('app_ticket_list') }}">Volver</a>
	<a class="btn btn-warning" href="{{ path('app_ticket_id_edit', {'id': ticket.id}) }}">Editar</a>
	<a class="btn btn-danger" href="{{ path('app_ticket_id_delete', {'id': ticket.id}) }}" onclick="return confirm('¿Estás seguro de que quieres borrar este ticket?');">Borrar</a>
{% endblock %}
