{% extends 'base.html.twig' %}

{% block title %}Show Ticket
{% endblock %}

{% block body %}

	<div class="example-wrapper">
		<h1>Ticket: {{ticket.title}}</h1>

		<p><strong>Descripción:</strong> {{ticket.description}}
		</p>
		<p><strong>Fecha de creación:</strong> {{ticket.createdAt|date()}}
		</p>
        <p><strong>Creador:</strong> {{ticket.creator.email}}
		</p>
	</div>
{% endblock %}
