{% extends 'baseTicket.html.twig' %}

{% block title %}Show Ticket
{% endblock %}

{% block body %}

	<h1>Información del ticket</h1>

	<table class="table table-striped table-bordered">
		<tr>
			<th>Título</th>
			<td>{{ticket.title}}</td>
		</tr>
		<tr>
			<th>Descripción</th>
			<td>{{ticket.description}}</td>
		</tr>
		<tr>
			<th>Estado</th>
			<td>{{ticket.status.value}}</td>
		</tr>
		<tr>
			<th>Fecha creación</th>
			<td>{{ticket.createdAt|date('d/m/Y H:i', 'Europe/Madrid')}}</td>
		</tr>
		<tr>
			<th>Creador</th>
			<td>{{ticket.creator.email}}</td>
		</tr>
	</table>

	<a class="btn btn-primary" href="{{ path('app_ticket_list') }}">Volver</a>
	{% if ticket.status is same as (constant('App\\Enum\\TicketStatus::OPEN')) %}
		<a class="btn btn-success" href="{{ path('app_ticket_id_close', {'id': ticket.id}) }}">Cerrar</a>
	{% else %}
		<a class="btn btn-success" href="{{ path('app_ticket_id_reopen', {'id': ticket.id}) }}">Reabrir</a>
	{% endif %}
	<a class="btn btn-warning" href="{{ path('app_ticket_id_edit', {'id': ticket.id}) }}">Editar</a>
	<form method="post" action="{{ path('app_ticket_id_delete', {'id': ticket.id}) }}" style="display:inline;" onsubmit="return confirm('¿Estás seguro de que quieres borrar este ticket?');">
		<input
		type="hidden" name="_token" value="{{ csrf_token('delete' ~ ticket.id) }}">
		{#
			Token CSRF.
			Symfony genera un token único para esta operación de borrado.
			Así evitamos que otras webs puedan enviar peticiones POST
			haciéndose pasar por el usuario autenticado.
		#}
		<button type="submit" class="btn btn-danger">Borrar</button>
	</form>
{% endblock %}
