{% extends 'baseTicket.html.twig' %}

{% block title %}List Tickets
{% endblock %}

{% block body %}
	<div>
		<h1>Mis Tickets</h1>

		<table class="table table-striped table-bordered">
			<tr>
				<th>Título</th>
				<th>Descripción</th>
				<th>Fecha creación</th>
				<th>Acciones</th>
			</tr>
			{% for ticket in tickets %}
				<tr>
					<td>{{ticket.title}}
					</td>
					<td>{{ticket.description}}
					</td>
					<td>{{ticket.createdAt|date()}}
					</td>
					<td>
						<a class="btn btn-sm btn-primary" href="{{ path('app_ticket_id', {'id': ticket.id}) }}">Ver</a>
						<a class="btn btn-sm btn-warning" href="#">Editar</a>
						<a class="btn btn-sm btn-danger" href="#">Borrar</a>
					</td>
				</tr>
			{% endfor %}
		</table>
	</div>
{% endblock %}
