{% extends 'baseTicket.html.twig' %}

{% block title %}List Tickets
{% endblock %}

{% block body %}
	<div>
		<h1>Mis Tickets</h1>

		{% if tickets is empty %}
			<p>No tienes tickets todavía</p>
		{% else %}
			<table class="table table-striped table-bordered">
				<thead>
					<tr>
						<th>Título</th>
						<th>Descripción</th>
						<th>Estado</th>
						<th>Fecha creación</th>
						<th>Acciones</th>
					</tr>
				</thead>
				<tbody>
					{% for ticket in tickets %}
						<tr>
							<td>{{ticket.title}}
							</td>
							<td>{{ticket.description}}
							</td>
							<td>{{ticket.status.value}}
							</td>
							<td>{{ticket.createdAt|date('d/m/Y H:i','Europe/Madrid')}}
							</td>
							<td>
								<a class="btn btn-sm btn-primary" href="{{ path('app_ticket_id', {'id': ticket.id}) }}">Ver</a>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		{% endif %}

	</div>
{% endblock %}
