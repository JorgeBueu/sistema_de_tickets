{% extends 'baseTicket.html.twig' %}

{% block title %}Crear Ticket{% endblock %}

{% block body %}
    <h1>Crear nuevo ticket</h1>

    {{ form_start(ticketForm, {'attr': {'class': 'needs-validation'}}) }}

	<div class="mb-3">
		{{ form_label(ticketForm.title, 'Título') }}
		{{ form_widget(ticketForm.title, {'attr': {'class': 'form-control'}}) }}
		{{ form_errors(ticketForm.title) }}
	</div>

	<div class="mb-3">
		{{ form_label(ticketForm.description, 'Descripción') }}
		{{ form_widget(ticketForm.description, {'attr': {'class': 'form-control'}}) }}
		{{ form_errors(ticketForm.description) }}
	</div>

	<button type="submit" class="btn btn-success">Crear</button>
	<a class="btn btn-danger" href="{{ path('app_ticket_list') }}">Cancelar</a>

	{{ form_end(ticketForm) }}

{% endblock %}
